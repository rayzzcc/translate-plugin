// =====================================================================
//  双语翻译助手 · 配置文件（JSONC：支持 // 注释和末尾逗号）
//
//  使用方式：
//    1. 首次构建时会自动把 config.example.jsonc 复制成 config.jsonc；
//       之后只需要修改项目根目录下的 config.jsonc。
//    2. 修改后执行 `npm run build`（或保持 `npm run dev` 运行，会自动同步），
//       然后在设置页「翻译服务」里点「重新加载配置文件」即可生效。
//       也可以直接修改 dist/config.jsonc，同样点「重新加载配置文件」生效。
//
//  注意：config.jsonc 中含有 API Key，请勿分享或提交到代码仓库。
// =====================================================================
{
  // ------------------------------------------------------------------
  //  翻译服务（大模型）列表
  //
  //  type 可选：
  //    "openai"    —— 兼容 OpenAI Chat Completions 接口：OpenAI、DeepSeek、
  //                   通义千问、Kimi、豆包、Ollama、公司内部网关等
  //                   baseUrl 填到 /v1 即可（会自动拼接 /chat/completions），
  //                   也可以直接填完整的 .../chat/completions 地址
  //    "anthropic" —— Claude 原生接口（baseUrl 默认 https://api.anthropic.com）
  //    "gemini"    —— Gemini 原生接口（baseUrl 默认 https://generativelanguage.googleapis.com）
  //
  //  其他字段（均可选）：
  //    temperature     采样温度，不填则使用模型默认值
  //    maxTokens       最大输出 token（anthropic 必需，默认 4096）
  //    maxConcurrent   最大并发请求数（默认 4）
  //    rpm             每分钟最大请求数（0 = 不限制）
  //    timeoutMs       单次请求超时（默认 60000）
  //    vision          是否支持识图（图片解读需要）
  //    batchSize       每次请求最多合并多少段文本（默认取设置里的值）
  //    batchChars      每次请求最多合并多少字符
  //    extraBody       额外合并进请求体的参数，例如关闭思考模式
  //    extraHeaders    额外请求头
  // ------------------------------------------------------------------
  "providers": [
    {
      "id": "mimo",
      "name": "MiMo Flash",
      "type": "openai",
      "baseUrl": "https://your-gateway.example.com/v1",
      "apiKey": "YOUR_API_KEY",
      "model": "xiaomi/mimo-v2.6-flash",
      "temperature": 0.3,
      "maxConcurrent": 4,
      "rpm": 0,
      "timeoutMs": 60000,
      "vision": false,
      // 翻译不需要思考模式，强烈建议关闭。不同网关参数名不同，按需取消注释其中一个：
      "extraBody": {
        // "enable_thinking": false,
        // "thinking": { "type": "disabled" },
        // "chat_template_kwargs": { "enable_thinking": false },
      },
      "extraHeaders": {}
    },
    {
      "id": "claude-haiku",
      "name": "Claude Haiku",
      "type": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "apiKey": "YOUR_API_KEY",
      "model": "claude-haiku-5-5",
      "maxTokens": 4096,
      "vision": true
    },
    {
      "id": "gemini-flash",
      "name": "Gemini Flash",
      "type": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com",
      "apiKey": "YOUR_API_KEY",
      "model": "gemini-2.5-flash",
      "temperature": 0.3,
      "vision": true,
      // 关闭 Gemini 2.5 的思考，显著提升速度
      "extraBody": { "generationConfig": { "thinkingConfig": { "thinkingBudget": 0 } } }
    },
    {
      "id": "openai-mini",
      "name": "OpenAI mini",
      "type": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "YOUR_API_KEY",
      "model": "gpt-4.1-mini",
      "temperature": 0.3,
      "vision": true
    },
    {
      "id": "ollama",
      "name": "本地 Ollama",
      "type": "openai",
      "baseUrl": "http://localhost:11434/v1",
      "apiKey": "",
      "model": "qwen2.5:7b",
      "maxConcurrent": 2
    }
  ],

  // 默认使用的翻译服务（填上面 providers 的 id）
  "defaultProvider": "mimo",

  // 图片解读（讲解 / 文字翻译）使用的服务（需要 vision: true 的模型），留空则使用 defaultProvider
  "imageProvider": "",

  // ------------------------------------------------------------------
  //  默认设置（可选）。这里的值是“配置文件默认值”，在设置页修改的内容会覆盖它们；
  //  设置页「备份与恢复」中的「恢复为配置文件默认值」可清除界面上的修改。
  //  完整字段见 README.md。
  // ------------------------------------------------------------------
  "settings": {
    "targetLang": "zh-CN",
    "displayMode": "bilingual",
    "style": { "theme": "dashed" },
    "input": { "targetLang": "en" },
    "hover": { "key": "Control" }
  },

  // ------------------------------------------------------------------
  //  提示词（可选，不填使用内置默认）。可用变量：
  //    {{to}}       目标语言英文名，如 Simplified Chinese
  //    {{text}}     待翻译文本（批量时为 <seg id="N">…</seg> 列表）
  //    {{context}}  上下文（网页标题 / 视频标题），可能为空
  //  批量模板(batch/subtitle) 必须要求模型按 <seg id="N"></seg> 原样返回。
  //  可覆盖的键：system / single / batch / subtitle / image（图片文字翻译）/
  //            imageExplainSystem / imageExplain（图片讲解，{{context}} 为图片周围的网页内容）
  // ------------------------------------------------------------------
  "prompts": {
    // "system": "You are a professional translation engine ...",
    // "single": "{{context}}Translate the following text into {{to}}:\n\n{{text}}",
  }
}
