{
  "manifest_version": 3,
  "name": "双语翻译助手",
  "description": "大模型驱动的沉浸式双语网页翻译：网页对照、划词、悬停、输入框、图片、YouTube 字幕、PDF。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "双语翻译助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+A" },
      "description": "翻译当前页面 / 显示原文"
    },
    "toggle-mode": {
      "suggested_key": { "default": "Alt+W" },
      "description": "切换 双语对照 / 仅译文"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "翻译选中的文字"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
